{
  "name": "xss-lab",
  "version": "1.0.0",
  "scripts": {
    "test": "jest",
    "lint": "eslint assets/js/**/*.js",
    "build": "mkdir -p dist && cp index.html dist/ && cp -r assets dist/",
    "review": "python scripts/stackspot_review.py",
    "review:threads": "python scripts/stackspot_review_threads.py",
    "pipeline": "jest --json --outputFile=jest-results.json && python scripts/stackspot_review.py",
    "pipeline:threads": "jest --json --outputFile=jest-results.json && python scripts/stackspot_review_threads.py"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "eslint": "^8.57.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
